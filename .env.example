# --- Supabase (público, seguro exponer en el navegador) ---
# Panel de Supabase -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Supabase (PRIVADO, nunca lo mandes al cliente ni lo subas a GitHub) ---
# Mismo panel -> API -> "service_role" key (bypassa RLS, solo se usa server-side)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Panel admin ---
ADMIN_PASSWORD=cambia-esto-por-algo-seguro
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=genera-un-secreto-aleatorio-largo-aqui

# --- Tasa de cambio (manual por ahora) ---
PUBLIC_BS_RATE=145.32
