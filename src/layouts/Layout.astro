---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "DRAPE — Catálogo" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/dp-logo.png" />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta
      name="description"
      content="Catálogo exclusivo de franelas Essentials, Corteiz, Chrome Hearts y más. Stock real y envíos a todo el país."
    />
    <meta
      name="keywords"
      content="Ropa, Streetwear, Essentials, Corteiz, Franelas, Venezuela, DRAPE"
    />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tudominio.com/" />
    <meta property="og:title" content="DRAPE | Streetwear Exclusivo" />
    <meta
      property="og:description"
      content="Descubre nuestra colección de piezas originales. Stock limitado."
    />
    <meta
      property="og:image"
      content="https://tudominio.com/images/og-preview.svg"
    />
    <meta property="og:site_name" content="DRAPE" />
    <meta property="og:locale" content="es_VE" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://tudominio.com/" />
    <meta property="twitter:title" content="DRAPE | Streetwear Exclusivo" />
    <meta
      property="twitter:description"
      content="Descubre nuestra colección de piezas originales. Stock limitado."
    />
    <meta
      property="twitter:image"
      content="https://tudominio.com/images/og-preview.svg"
    />
    <meta property="twitter:image:alt" content="DRAPE | Streetwear Exclusivo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Archivo+Black&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream font-body text-ink antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
