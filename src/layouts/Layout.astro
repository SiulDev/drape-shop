---
import { WHATSAPP_NUMBER } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "DRAPE — Catálogo",
  description = "Catálogo exclusivo de streetwear con stock real y pedidos directos por WhatsApp.",
  noindex = false,
} = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/dp-logo.png" />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta
      name="keywords"
      content="Ropa, Streetwear, Essentials, Corteiz, Franelas, Venezuela, DRAPE"
    />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="DRAPE | Streetwear Exclusivo" />
    <meta
      property="og:description"
      content="Descubre nuestra colección de piezas originales. Stock limitado."
    />
    <meta property="og:image" content={`${siteUrl}/images/og-preview.svg`} />
    <meta property="og:site_name" content="DRAPE" />
    <meta property="og:locale" content="es_VE" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content="DRAPE | Streetwear Exclusivo" />
    <meta
      property="twitter:description"
      content="Descubre nuestra colección de piezas originales. Stock limitado."
    />
    <meta
      property="twitter:image"
      content={`${siteUrl}/images/og-preview.svg`}
    />
    <meta property="twitter:image:alt" content="DRAPE | Streetwear Exclusivo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Archivo+Black&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream font-body text-ink antialiased overflow-x-hidden">
    <slot />
    <a
      href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hola DRAPE, tengo una duda")}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      title="Contactar por WhatsApp"
      class="fixed bottom-8 right-8 z-[999] inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-black bg-[#25D366] text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-y-1 hover:shadow-none"
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-7 w-7"
        aria-hidden="true"
      >
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2"
        ></path>
      </svg>
    </a>
  </body>
</html>
