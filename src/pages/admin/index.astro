---
import Layout from "../../layouts/Layout.astro";
import { supabaseAdmin } from "../../lib/supabase-admin";

const { data: products, error } = await supabaseAdmin
  .from("products")
  .select("*")
  .order("created_at", { ascending: false });

const successMsg = Astro.url.searchParams.get("success");
const errorMsg = Astro.url.searchParams.get("error");
---
<Layout title="Admin — DRAPE">
  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-10">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-2">
        <img src="/images/dp-logo.png" alt="Drape" class="h-7 w-auto" />
        <h1 class="font-display text-xl">DRAPE ADMIN</h1>
      </div>
      <form method="POST" action="/api/admin/logout">
        <button class="font-mono text-xs text-ink-soft hover:text-red-drape">Cerrar sesión</button>
      </form>
    </div>

    {successMsg && <p class="mb-6 rounded-lg bg-green-100 text-green-800 text-sm px-4 py-3">Guardado con éxito.</p>}
    {errorMsg && <p class="mb-6 rounded-lg bg-red-drape/10 text-red-drape text-sm px-4 py-3">{errorMsg}</p>}
    {error && (
      <p class="mb-6 rounded-lg bg-red-drape/10 text-red-drape text-sm px-4 py-3">
        Error consultando productos: {error.message}. ¿Ya corriste supabase/schema.sql y configuraste el .env?
      </p>
    )}

    <!-- Agregar franela nueva -->
    <section class="mb-10 rounded-2xl bg-card border border-ink/10 p-6">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-soft mb-4">Agregar franela</h2>
      <form method="POST" action="/api/admin/products/create" enctype="multipart/form-data" class="grid gap-3 sm:grid-cols-2">
        <input
          name="name"
          placeholder="Nombre (ej: Essentials Tee — Negro)"
          required
          class="rounded-lg border border-ink/15 bg-cream px-3 py-2 text-sm sm:col-span-2"
        />
        <input
          name="brand"
          placeholder="Marca (ej: Essentials)"
          required
          class="rounded-lg border border-ink/15 bg-cream px-3 py-2 text-sm"
        />
        <input
          name="price"
          type="number"
          step="0.01"
          min="0"
          placeholder="Precio USD"
          required
          class="rounded-lg border border-ink/15 bg-cream px-3 py-2 text-sm"
        />
        <label class="flex items-center gap-2 text-sm sm:col-span-2">
          <input type="file" name="image" accept="image/*" class="text-xs" />
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="in_stock" checked class="accent-red-drape" />
          Disponible en stock
        </label>
        <button type="submit" class="sm:col-span-2 rounded-full bg-ink text-cream font-semibold py-2.5 hover:bg-red-drape transition-colors">
          Guardar franela
        </button>
      </form>
    </section>

    <!-- Lista / edición rápida -->
    <section class="space-y-3">
      {products?.map((p) => (
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl bg-card border border-ink/10 p-4">
          <img
            src={p.image_url || "/images/dp-logo.png"}
            alt={p.name}
            class="w-16 h-16 rounded-lg object-cover bg-cream border border-ink/10"
          />

          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate">{p.name}</p>
            <p class="font-mono text-xs text-ink-soft">{p.brand}</p>
          </div>

          <form method="POST" action="/api/admin/products/update-price" class="flex items-center gap-2">
            <input type="hidden" name="id" value={p.id} />
            <span class="font-mono text-xs text-ink-soft">$</span>
            <input
              type="number"
              step="0.01"
              min="0"
              name="price"
              value={p.price_usd}
              class="w-20 rounded-lg border border-ink/15 bg-cream px-2 py-1 text-sm font-mono"
            />
            <button class="font-mono text-[10px] uppercase rounded-full bg-ink text-cream px-3 py-1.5 hover:bg-red-drape transition-colors">
              Actualizar
            </button>
          </form>

          <form method="POST" action="/api/admin/products/toggle-stock">
            <input type="hidden" name="id" value={p.id} />
            <input type="hidden" name="in_stock" value={String(p.in_stock)} />
            <button
              class:list={[
                "font-mono text-[10px] uppercase rounded-full px-3 py-1.5 transition-colors",
                p.in_stock ? "bg-ink text-cream hover:bg-red-drape" : "bg-cream text-ink border border-ink/20 hover:border-ink",
              ]}
            >
              {p.in_stock ? "En stock" : "Agotado"}
            </button>
          </form>

          <form method="POST" action="/api/admin/products/delete" onsubmit="return confirm('¿Borrar esta franela?')">
            <input type="hidden" name="id" value={p.id} />
            <input type="hidden" name="image_path" value={p.image_url ? p.image_url.split("/products/")[1] : ""} />
            <button class="font-mono text-[10px] uppercase text-ink-soft hover:text-red-drape px-2">Borrar</button>
          </form>
        </div>
      ))}

      {products?.length === 0 && <p class="text-sm text-ink-soft text-center py-10">Todavía no hay franelas cargadas.</p>}
    </section>
  </main>
</Layout>
