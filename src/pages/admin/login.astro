---
import Layout from "../../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
---
<Layout title="Admin — DRAPE">
  <main class="min-h-screen flex items-center justify-center px-4">
    <form method="POST" action="/api/admin/login" class="w-full max-w-sm rounded-2xl bg-card p-8 border border-ink/10">
      <div class="flex items-center gap-2 mb-6 justify-center">
        <img src="/images/dp-logo.png" alt="Drape" class="h-8 w-auto" />
        <span class="font-display text-lg">DRAPE ADMIN</span>
      </div>

      {error && (
        <p class="mb-4 rounded-lg bg-red-drape/10 border border-red-drape/30 text-red-drape text-sm px-3 py-2 text-center">
          Contraseña incorrecta.
        </p>
      )}

      <label class="block mb-2 font-mono text-xs uppercase tracking-wide text-ink-soft">Contraseña</label>
      <input
        type="password"
        name="password"
        required
        autofocus
        class="w-full rounded-lg border border-ink/15 bg-cream px-4 py-3 mb-4 outline-none focus:border-red-drape"
      />

      <button type="submit" class="w-full rounded-full bg-ink text-cream font-semibold py-3 hover:bg-red-drape transition-colors">
        Entrar
      </button>
    </form>
  </main>
</Layout>
