---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin secreto - DRAPE">
  <main
    class="min-h-screen w-full bg-[#f4f1e1] p-4 sm:p-8 flex flex-col gap-6 items-center md:grid md:grid-cols-2 md:gap-8 md:items-start"
  >
    <section
      class="w-full max-w-lg border border-gray-300 rounded-xl bg-card p-5 shadow-sm sm:p-8"
    >
      <h1 class="mb-8 text-center font-display text-2xl text-ink sm:text-3xl">
        Subir producto
      </h1>

      <form id="producto-form" class="space-y-5">
        <label class="block font-mono text-xs font-bold uppercase text-ink">
          Nombre
          <input
            id="nombre"
            type="text"
            placeholder="Nombre del producto"
            required
            class="mt-2 h-14 w-full rounded-xl border-2 border-black bg-cream px-4 text-base text-ink outline-none focus:ring-2 focus:ring-red-drape/30"
          />
        </label>
        <label class="block font-mono text-xs font-bold uppercase text-ink">
          Tallas
          <input
            id="tallas"
            type="text"
            placeholder="Ej. S, M, L, XL"
            required
            class="mt-2 h-14 w-full rounded-xl border-2 border-black bg-cream px-4 text-base text-ink outline-none focus:ring-2 focus:ring-red-drape/30"
          />
        </label>
        <label class="block font-mono text-xs font-bold uppercase text-ink">
          Precio USD
          <input
            id="precio"
            type="number"
            step="0.01"
            placeholder="0.00"
            required
            class="mt-2 h-14 w-full rounded-xl border-2 border-black bg-cream px-4 text-base text-ink outline-none focus:ring-2 focus:ring-red-drape/30"
          />
        </label>
        <label class="block font-mono text-xs font-bold uppercase text-ink">
          Imagen frontal
          <input
            id="imagenFrente"
            type="file"
            accept="image/png, image/jpeg, image/webp"
            required
            class="mt-2 min-h-14 w-full rounded-xl border-2 border-black bg-cream p-3 text-sm text-ink file:mr-3 file:rounded-lg file:border-0 file:bg-ink file:px-3 file:py-2 file:font-mono file:text-xs file:font-bold file:text-cream"
          />
          <img
            id="previewFrente"
            src=""
            alt="Vista previa frontal"
            class="mt-3 hidden h-48 w-full rounded-xl border-2 border-black object-cover"
          />
        </label>
        <label class="block font-mono text-xs font-bold uppercase text-ink">
          Imagen trasera
          <input
            id="imagenAtras"
            type="file"
            accept="image/png, image/jpeg, image/webp"
            required
            class="mt-2 min-h-14 w-full rounded-xl border-2 border-black bg-cream p-3 text-sm text-ink file:mr-3 file:rounded-lg file:border-0 file:bg-ink file:px-3 file:py-2 file:font-mono file:text-xs file:font-bold file:text-cream"
          />
          <img
            id="previewAtras"
            src=""
            alt="Vista previa trasera"
            class="mt-3 hidden h-48 w-full rounded-xl border-2 border-black object-cover"
          />
        </label>
        <button
          id="submit-button"
          type="submit"
          class="w-full rounded-xl border-2 border-black bg-ink px-4 py-4 font-mono text-sm font-bold uppercase text-cream transition-colors hover:bg-red-drape disabled:cursor-not-allowed disabled:bg-gray-700"
        >
          Subir producto
        </button>
      </form>
    </section>

    <section
      class="w-full max-w-lg border border-gray-300 rounded-xl bg-white p-5 shadow-sm sm:p-8"
    >
      <h2 class="mb-6 font-display text-2xl text-black">Inventario Actual</h2>
      <div id="inventario" class="grid gap-4 sm:grid-cols-2">
        <p class="col-span-full font-mono text-sm text-ink">
          Cargando inventario...
        </p>
      </div>
    </section>
  </main>

  <div
    id="feedback-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="feedback-message"
  >
    <div
      class="w-full max-w-md rounded-xl border-2 border-black bg-white p-6 shadow-sm"
    >
      <p id="feedback-message" class="font-mono text-sm font-bold text-black">
      </p>
      <button
        id="close-feedback"
        type="button"
        class="mt-6 w-full rounded-xl border-2 border-black bg-black px-4 py-3 font-mono text-sm font-bold uppercase text-white hover:bg-red-drape"
      >
        Cerrar
      </button>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  import { supabase } from "../lib/supabase.ts";

  const form = document.getElementById("producto-form");
  const button = document.getElementById("submit-button");
  const imagenFrenteInput = document.getElementById("imagenFrente");
  const imagenAtrasInput = document.getElementById("imagenAtras");
  const previewFrente = document.getElementById("previewFrente");
  const previewAtras = document.getElementById("previewAtras");
  const inventory = document.getElementById("inventario");
  const feedbackModal = document.getElementById("feedback-modal");
  const feedbackMessage = document.getElementById("feedback-message");
  const closeFeedback = document.getElementById("close-feedback");

  function mostrarFeedback(message) {
    feedbackMessage.textContent = message;
    feedbackModal.classList.remove("hidden");
    feedbackModal.classList.add("flex");
  }

  closeFeedback.addEventListener("click", () => {
    feedbackModal.classList.add("hidden");
    feedbackModal.classList.remove("flex");
  });

  imagenFrenteInput.addEventListener("change", () => {
    const file = imagenFrenteInput.files[0];
    if (!file) return;
    previewFrente.src = URL.createObjectURL(file);
    previewFrente.classList.remove("hidden");
  });

  imagenAtrasInput.addEventListener("change", () => {
    const file = imagenAtrasInput.files[0];
    if (!file) return;
    previewAtras.src = URL.createObjectURL(file);
    previewAtras.classList.remove("hidden");
  });

  async function obtenerTasaBCV() {
    try {
      const respuesta = await fetch(
        "https://ve.dolarapi.com/v1/dolares/oficial",
      );
      if (!respuesta.ok) throw new Error(`BCV API: ${respuesta.status}`);
      const { promedio } = await respuesta.json();
      return typeof promedio === "number" ? promedio : null;
    } catch (error) {
      console.error("No se pudo obtener la tasa del BCV", error);
      return null;
    }
  }

  async function cargarInventario() {
    const { data: productos, error } = await supabase
      .from("productos")
      .select("*")
      .order("created_at", { ascending: false });

    if (error) throw error;
    const tasaBCV = await obtenerTasaBCV();
    inventory.innerHTML = "";

    if (!productos.length) {
      inventory.innerHTML =
        '<p class="col-span-full font-mono text-sm text-ink">No hay productos todavía.</p>';
      return;
    }

    productos.forEach((producto) => {
      const item = document.createElement("article");
      item.className =
        "rounded-xl border-2 border-black bg-cream p-3 shadow-sm";
      item.innerHTML = `
        <img src="${producto.imagen}" alt="${producto.nombre}" class="mb-3 h-48 w-full rounded-xl border-2 border-black object-cover" />
        <h3 class="font-bold text-black">${producto.nombre}</h3>
        <p class="mt-1 text-xs text-gray-600">Precio: $${producto.precioUSD}</p>
        <p class="text-xs text-gray-600">Bs ${tasaBCV !== null ? (Number(producto.precioUSD) * tasaBCV).toLocaleString("es-VE", { maximumFractionDigits: 0 }) : "--"}</p>
        <p class="text-xs text-gray-600">Tallas: ${producto.tallas}</p>
        <p class="mt-1 font-mono text-xs font-bold uppercase text-black">${producto.enStock ? "En Stock" : "Agotado"}</p>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <button type="button" data-stock-id="${producto.id}" class="rounded-lg border-2 border-black bg-black px-2 py-2 font-mono text-xs font-bold uppercase text-white hover:bg-lime hover:text-black">${producto.enStock ? "Quitar Stock" : "Poner en Stock"}</button>
          <button type="button" data-delete-id="${producto.id}" class="rounded-lg border-2 border-black bg-red-drape px-2 py-2 font-mono text-xs font-bold uppercase text-white hover:bg-black">Eliminar</button>
        </div>
      `;
      inventory.appendChild(item);
    });

    inventory.querySelectorAll("[data-stock-id]").forEach((button) => {
      button.addEventListener("click", async () => {
        const producto = productos.find(
          (item) => item.id === button.dataset.stockId,
        );
        if (!producto) return;
        const { error: updateError } = await supabase
          .from("productos")
          .update({ enStock: !producto.enStock })
          .eq("id", producto.id);
        if (updateError) {
          mostrarFeedback("Error: " + updateError.message);
          return;
        }
        window.location.reload();
      });
    });

    inventory.querySelectorAll("[data-delete-id]").forEach((button) => {
      button.addEventListener("click", async () => {
        if (!confirm("¿Eliminar este producto?")) return;
        const { error: deleteError } = await supabase
          .from("productos")
          .delete()
          .eq("id", button.dataset.deleteId);
        if (deleteError) {
          mostrarFeedback("Error: " + deleteError.message);
          return;
        }
        window.location.reload();
      });
    });
  }

  cargarInventario().catch((error) => {
    inventory.innerHTML = `<p class="col-span-full font-mono text-sm text-red-drape">Error cargando inventario: ${error.message}</p>`;
    mostrarFeedback("Error: " + error.message);
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.textContent = "SUBIENDO AL CATÁLOGO... ESPERA";
    button.disabled = true;

    try {
      const nombre = document.getElementById("nombre").value;
      const tallas = document.getElementById("tallas").value;
      const precio = Number(document.getElementById("precio").value);
      const imagenFrente = document.getElementById("imagenFrente").files[0];
      const imagenAtras = document.getElementById("imagenAtras").files[0];
      const timestamp = Date.now();
      const nombreFrente = imagenFrente.name.replace(/\s+/g, "-");
      const nombreAtras = imagenAtras.name.replace(/\s+/g, "-");
      const fileNameFrente = timestamp + "-frente-" + nombreFrente;
      const fileNameAtras = timestamp + "-atras-" + nombreAtras;

      const { error: frenteError } = await supabase.storage
        .from("imagenes-drape")
        .upload(fileNameFrente, imagenFrente);
      if (frenteError) throw frenteError;

      const { error: atrasError } = await supabase.storage
        .from("imagenes-drape")
        .upload(fileNameAtras, imagenAtras);
      if (atrasError) throw atrasError;

      const { data: frenteUrl } = supabase.storage
        .from("imagenes-drape")
        .getPublicUrl(fileNameFrente);
      const { data: atrasUrl } = supabase.storage
        .from("imagenes-drape")
        .getPublicUrl(fileNameAtras);

      const { error: insertError } = await supabase.from("productos").insert({
        nombre,
        tallas,
        precioUSD: precio,
        imagen: frenteUrl.publicUrl,
        imagenAtras: atrasUrl.publicUrl,
        enStock: true,
      });
      if (insertError) throw insertError;

      mostrarFeedback("Producto subido correctamente.");
      event.target.reset();
      previewFrente.src = "";
      previewAtras.src = "";
      previewFrente.classList.add("hidden");
      previewAtras.classList.add("hidden");
    } catch (error) {
      mostrarFeedback("Error: " + error.message);
    } finally {
      button.textContent = "Subir producto";
      button.disabled = false;
    }
  });
</script>
