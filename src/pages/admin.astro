---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin — DRAPE">
  <main class="flex min-h-screen items-center justify-center px-4 py-10">
    <form
      id="productoForm"
      class="w-full max-w-md space-y-4 border-4 border-black bg-card p-6 shadow-lg shadow-black/15 sm:p-8"
    >
      <h1 class="mb-6 font-display text-2xl text-ink">Subir producto</h1>

      <input
        id="adminPass"
        type="password"
        placeholder="Contraseña"
        required
        class="w-full border-2 border-black bg-cream px-3 py-2 text-sm text-ink"
      />
      <input
        id="prodNombre"
        type="text"
        placeholder="Nombre del producto"
        required
        class="w-full border-2 border-black bg-cream px-3 py-2 text-sm text-ink"
      />
      <input
        id="prodTallas"
        type="text"
        placeholder="Tallas"
        required
        class="w-full border-2 border-black bg-cream px-3 py-2 text-sm text-ink"
      />
      <input
        id="prodPrecio"
        type="number"
        placeholder="Precio USD"
        required
        class="w-full border-2 border-black bg-cream px-3 py-2 text-sm text-ink"
      />
      <input
        id="prodImagen"
        type="file"
        accept="image/*"
        required
        class="w-full border-2 border-black bg-cream px-3 py-2 text-sm text-ink"
      />

      <button
        type="submit"
        class="w-full border-4 border-black bg-ink px-4 py-3 font-mono text-sm font-bold text-cream transition-colors hover:bg-red-drape"
      >
        Subir Producto
      </button>
    </form>
  </main>
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const form = document.getElementById("productoForm");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const adminPass = document.getElementById("adminPass") as HTMLInputElement;
    const prodNombre = document.getElementById(
      "prodNombre",
    ) as HTMLInputElement;
    const prodTallas = document.getElementById(
      "prodTallas",
    ) as HTMLInputElement;
    const prodPrecio = document.getElementById(
      "prodPrecio",
    ) as HTMLInputElement;
    const prodImagen = document.getElementById(
      "prodImagen",
    ) as HTMLInputElement;

    if (adminPass.value !== "1234") {
      alert("Clave incorrecta");
      return;
    }

    try {
      const file = document.getElementById("prodImagen").files[0];
      const precio = Number(prodPrecio.value);
      const fileName = Date.now() + "-" + file.name.replace(/\s+/g, "-");

      const { error: uploadError } = await supabase.storage
        .from("imagenes-drape")
        .upload(fileName, file);

      if (uploadError) throw uploadError;

      const { data: publicUrlData } = supabase.storage
        .from("imagenes-drape")
        .getPublicUrl(fileName);

      const { error: insertError } = await supabase.from("productos").insert({
        nombre: prodNombre.value,
        tallas: prodTallas.value,
        precioUSD: precio,
        imagen: publicUrlData.publicUrl,
        enStock: true,
      });

      if (insertError) throw insertError;

      alert("¡ÉXITO!");
      form.reset();
    } catch (error) {
      alert("ERROR: " + error.message);
    }
  });
</script>
