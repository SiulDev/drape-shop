---
import { SITE, WHATSAPP_NUMBER } from "../config";
---

<header
  class="z-50 w-full px-4 pt-6 sm:px-6 fixed top-0 left-0 right-0 bg-black/95 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 rounded-full bg-black/95 px-4 py-3 text-cream shadow-lg shadow-ink/20 backdrop-blur sm:flex-nowrap sm:px-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src="/images/dp-logo.png" alt={SITE.name} class="h-6 w-auto" />
      <span class="font-display text-sm tracking-wide text-cream"
        >{SITE.name}</span
      >
    </a>

    <nav class="flex items-center gap-6 text-sm font-medium text-cream">
      <a href="#como-comprar" class="transition-colors hover:text-red-drape"
        >Cómo comprar</a
      >
      <a href="#catalogo" class="transition-colors hover:text-red-drape"
        >Catálogo</a
      >
    </nav>

    <a
      href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hola DRAPE, tengo una duda")}`}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-xl bg-cream px-3 py-2 text-xs font-semibold text-ink transition-colors hover:bg-red-drape hover:text-cream sm:px-4"
      >Contacto</a
    >
  </div>
</header>
