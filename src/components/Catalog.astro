---
import { supabase } from "../lib/supabase";
import ProductCard from "./ProductCard.astro";

const { data: productos } = await supabase.from("productos").select("*");
---

<section
  id="catalogo"
  class="mx-auto w-full max-w-[1400px] px-4 pb-24 pt-20 sm:px-6 lg:px-8"
>
  <div
    class="mb-8 flex flex-col gap-4 sm:mb-10 md:flex-row md:items-end md:justify-between"
  >
    <div>
      <p
        class="font-mono text-[10px] font-bold uppercase tracking-[0.28em] text-red-drape"
      >
        Colección
      </p>
      <h2
        class="mt-2 font-display text-4xl leading-none tracking-[-0.06em] sm:text-5xl md:text-6xl"
      >
        Selección
        <span class="text-transparent [-webkit-text-stroke:1.5px_#14130d]">
          limitada.
        </span>
      </h2>
    </div>

    <p class="max-w-md text-sm leading-relaxed text-ink-soft sm:text-base">
      Essentials, Chrome Hearts, Corteiz y piezas raras para vestir sin ruido.
    </p>
  </div>

  <div
    id="grid"
    class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4"
  >
    {
      productos && productos.length > 0 ? (
        productos.map((producto) => (
          <ProductCard
            enStock={producto.enStock}
            imagen={producto.imagen}
            imagenAtras={producto.imagenAtras || ""}
            nombre={producto.nombre}
            precioUSD={producto.precioUSD}
            tallas={producto.tallas}
          />
        ))
      ) : (
        <p class="col-span-full py-10 text-center font-bold">
          Cargando catálogo...
        </p>
      )
    }
  </div>
</section>
