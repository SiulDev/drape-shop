---
import { supabase } from "../lib/supabase";
import ProductCard from "./ProductCard.astro";

const { data: productos } = await supabase.from("productos").select("*");
---

<section
  id="catalogo"
  class="mx-auto w-full max-w-5xl px-4 pb-24 pt-24 sm:px-6"
>
  <div
    id="grid"
    class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 md:grid-cols-3"
  >
    {
      productos && productos.length > 0 ? (
        productos.map((producto) => (
          <ProductCard
            enStock={producto.enStock}
            imagen={producto.imagen}
            imagenAtras={producto.imagenAtras || ""}
            nombre={producto.nombre}
            precioUSD={producto.precioUSD}
            tallas={producto.tallas}
          />
        ))
      ) : (
        <p class="col-span-full py-10 text-center font-bold">
          Cargando catálogo...
        </p>
      )
    }
  </div>
</section>
