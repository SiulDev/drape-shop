---
import { createClient } from "@supabase/supabase-js";
import ProductCard from "./ProductCard.astro";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);
const { data: rawProducts, error } = await supabase
  .from("productos")
  .select("*")
  .order("created_at", { ascending: false });
const products = (rawProducts ?? []).map((entry) => ({
  slug: entry.id,
  name: entry.nombre ?? "Producto",
  brand: entry.marca ?? "Sin marca",
  sizes: entry.tallas ?? "",
  price: entry.precioUSD ?? 0,
  inStock: entry.enStock ?? false,
  img: entry.imagen ?? "/images/og-preview.svg",
}));
---

<section
  id="catalogo"
  class="mx-auto w-full max-w-350 px-5 pb-24 pt-20 sm:px-6 lg:px-8"
>
  <div
    class="mb-8 flex flex-col gap-4 sm:mb-10 md:flex-row md:items-end md:justify-between"
  >
    <div>
      <p
        class="font-mono text-[10px] font-bold uppercase tracking-[0.28em] text-red-drape"
      >
        Colección
      </p>
      <h2
        class="mt-2 font-display text-4xl leading-none tracking-[-0.06em] sm:text-5xl md:text-6xl"
      >
        Selección
        <span class="text-transparent [-webkit-text-stroke:1.5px_#14130d]">
          limitada.
        </span>
      </h2>
    </div>

    <div class="max-w-md">
      <p class="text-sm leading-relaxed text-ink-soft sm:text-base">
        Essentials, Chrome Hearts, Corteiz y piezas raras para vestir sin ruido.
      </p>
    </div>
  </div>

  <div
    id="grid"
    class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4"
  >
    {
      !error && products.length > 0 ? (
        products.map((product) => (
          <div data-product-brand={product.brand}>
            <ProductCard {...product} />
          </div>
        ))
      ) : (
        <p class="col-span-full py-10 text-center font-bold">
          {error
            ? "Catálogo sin stock disponible por el momento."
            : "Catálogo sin productos disponibles."}
        </p>
      )
    }
  </div>
</section>
