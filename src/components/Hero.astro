---
const heroImage =
  "https://images.unsplash.com/photo-1523398002811-999ca8dec234?q=80&w=1200&auto=format&fit=crop&crop=faces&h=1500";
---

<section
  class="relative mx-auto w-full max-w-[1440px] px-5 pb-14 pt-20 sm:px-6 sm:pb-24 sm:pt-16 lg:px-8"
>
  <div
    class="flex flex-col items-center justify-center gap-10 md:flex-row md:items-center md:justify-center md:gap-16 lg:gap-24"
  >
    <div class="z-0 w-full max-w-xl md:w-[55%] lg:max-w-[620px]">
      <p
        class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.22em] text-red-drape sm:text-xs"
      >
        <span class="h-px w-5 bg-red-drape"></span>
        Catálogo · USD / Bs
      </p>
      <h1
        class="font-display text-[3.5rem] leading-[0.8] tracking-[-0.07em] sm:text-6xl md:text-7xl lg:text-[8rem]"
      >
        Piezas
        <br />
        <span class="text-transparent [-webkit-text-stroke:1.5px_#14130d]"
          >originales.</span
        >
      </h1>

      <p
        class="mt-6 max-w-lg text-sm leading-relaxed text-ink-soft sm:text-base"
      >
        Essentials, Corteiz, Chrome Hearts y más — seleccionadas, con stock real
        y pedido directo por WhatsApp.
      </p>

      <div class="mt-6 flex flex-row flex-wrap items-center gap-3 md:gap-4">
        <a
          href="#catalogo"
          class="inline-flex items-center justify-center rounded-full border-2 border-black bg-black px-4 py-3 font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-cream transition-colors hover:bg-red-drape sm:px-5"
        >
          Ver colección
        </a>

        <div
          class="hidden items-center gap-2 rounded-full border border-red-drape/30 bg-red-drape/10 px-3 py-2 sm:inline-flex sm:px-4"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-red-drape"></span>
          <span
            class="font-mono text-[9px] font-semibold uppercase tracking-wide text-red-drape sm:text-[10px]"
          >
            La pinta exacta 🇻🇪
          </span>
        </div>
      </div>
    </div>

    <div
      class="relative z-10 w-full max-w-md -ml-0 md:-ml-12 md:w-[45%] lg:-ml-16 lg:max-w-lg"
    >
      <div class="absolute -inset-4 rounded-[2rem] bg-red-drape/5 blur-2xl">
      </div>
      <div
        class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-ink/10 bg-card shadow-[0_30px_80px_rgba(20,19,13,0.12)]"
      >
        <img
          src={heroImage}
          alt="Modelo luciendo pieza DRAPE"
          class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
        />
      </div>

      <div
        class="absolute bottom-4 left-4 flex h-20 w-20 items-center justify-center rounded-full bg-ink p-2 text-center font-mono text-[9px] uppercase leading-tight tracking-wider text-cream shadow-lg"
      >
        TU PROPIO
        <br />
        ESTILO
      </div>
    </div>
  </div>

  <div
    class="w-screen relative left-[50%] right-[50%] -ml-[50vw] -mr-[50vw] mt-8 overflow-hidden border-y border-black/10 bg-black py-4 text-cream sm:mt-12"
  >
    <div
      class="flex min-w-max items-center gap-10 whitespace-nowrap py-1 font-mono text-[10px] uppercase tracking-[0.28em] sm:text-xs [animation:marquee_18s_linear_infinite]"
    >
      <span>DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span>
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
    </div>
  </div>
</section>
