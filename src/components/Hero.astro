---
const slides = [
  {
    image: "/images/photo-1523398002811-999ca8dec234.avif",
    alt: "Modelo con estilo urbano DRAPE",
    eyebrow: "Nueva temporada · 01",
    phrase: "Tu propio estilo.",
    detail: "Actitud que se nota.",
  },
  {
    image: "/images/corteiz-script-white.jpg",
    alt: "Pieza blanca de la colección DRAPE",
    eyebrow: "Piezas originales · 02",
    phrase: "Viste distinto.",
    detail: "Menos ruido. Más presencia.",
  },
  {
    image: "/images/chromehearts-black-red.jpg",
    alt: "Pieza negra de la colección DRAPE",
    eyebrow: "Stock limitado · 03",
    phrase: "Hazlo tuyo.",
    detail: "Tu uniforme para todos los días.",
  },
];
---

<section
  class="relative mx-auto w-full max-w-360 px-5 pb-24 pt-16 sm:px-6 lg:px-8"
>
  <div
    class="flex flex-col items-center justify-center gap-10 md:flex-row md:items-center md:justify-center md:gap-16 lg:gap-24"
  >
    <div class="z-0 w-full max-w-xl md:w-[55%] lg:max-w-155">
      <p
        data-hero-eyebrow
        class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.22em] text-red-drape sm:text-xs"
      >
        <span class="h-px w-5 bg-red-drape"></span>
        {slides[0].eyebrow}
      </p>
      <h1
        class="font-display text-5xl leading-[0.82] tracking-[-0.07em] sm:text-6xl md:text-7xl lg:text-[8rem]"
      >
        <span data-hero-phrase>{slides[0].phrase}</span>
        <br />
        <span
          data-hero-detail
          class="text-transparent [-webkit-text-stroke:1.5px_#14130d]"
          >{slides[0].detail}</span
        >
      </h1>

      <p
        class="mt-6 max-w-lg text-sm leading-relaxed text-ink-soft sm:text-base"
      >
        Essentials, Corteiz, Chrome Hearts y más — seleccionadas, con stock real
        y pedido directo por WhatsApp.
      </p>

      <div class="mt-6 flex flex-row flex-wrap items-center gap-3 md:gap-4">
        <a
          href="#catalogo"
          class="inline-flex items-center justify-center rounded-full border-2 border-black bg-black px-4 py-3 font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-cream transition-colors hover:bg-red-drape sm:px-5"
        >
          Ver colección
        </a>

        <div
          data-hero-status
          class="inline-flex items-center gap-2 rounded-full border border-red-drape/30 bg-red-drape/10 px-3 py-2 sm:px-4"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-red-drape"></span>
          <span
            class="font-mono text-[9px] font-semibold uppercase tracking-wide text-red-drape sm:text-[10px]"
          >
            La pinta exacta · 01 / 03
          </span>
        </div>
      </div>
    </div>

    <div
      class="relative z-10 w-full max-w-md md:-ml-12 md:w-[45%] lg:-ml-16 lg:max-w-lg"
    >
      <div class="absolute -inset-4 rounded-4xl bg-red-drape/5 blur-2xl"></div>
      <div
        class="relative aspect-4/5 overflow-hidden rounded-4xl border border-ink/10 bg-card shadow-[0_30px_80px_rgba(20,19,13,0.12)]"
      >
        {
          slides.map((slide, index) => (
            <img
              src={slide.image}
              alt={slide.alt}
              data-hero-slide
              data-slide-index={index}
              width="640"
              height="800"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "low"}
              class:list={["hero-slide", { "is-active": index === 0 }]}
            />
          ))
        }
      </div>

      <div
        class="absolute bottom-4 left-4 flex h-20 w-20 items-center justify-center rounded-full bg-ink p-2 text-center font-mono text-[9px] uppercase leading-tight tracking-wider text-cream shadow-lg"
      >
        <span data-hero-badge>Tu propio<br />estilo</span>
      </div>

      <div
        class="absolute bottom-4 right-4 flex items-center gap-2 sm:bottom-6 sm:right-6"
      >
        <button
          type="button"
          data-hero-prev
          class="hero-control"
          aria-label="Imagen anterior">←</button
        >
        <button
          type="button"
          data-hero-next
          class="hero-control"
          aria-label="Imagen siguiente">→</button
        >
      </div>
    </div>
  </div>

  <div
    class="relative left-[50%] right-[50%] ml-[-50vw] mr-[-50vw] mt-12 w-screen overflow-hidden border-y border-black/10 bg-black py-4 text-cream"
  >
    <div
      class="flex min-w-max items-center gap-10 whitespace-nowrap py-1 font-mono text-[10px] uppercase tracking-[0.28em] sm:text-xs animate-[marquee_18s_linear_infinite]"
    >
      <span>DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span>
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
      <span aria-hidden="true"
        >DRAPE ✦ PIEZAS ORIGINALES ✦ STOCK LIMITADO ✦</span
      >
    </div>
  </div>
</section>

<style>
  .hero-slide {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 700ms ease,
      transform 1200ms ease;
  }
  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .hero-control {
    display: grid;
    height: 2.25rem;
    width: 2.25rem;
    place-items: center;
    border: 1px solid rgba(239, 234, 218, 0.7);
    border-radius: 999px;
    background: rgba(20, 19, 13, 0.85);
    color: #efeada;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .hero-control:hover,
  .hero-control:focus-visible {
    background: #d1281c;
    color: #fff;
    outline: none;
  }
  [data-hero-phrase],
  [data-hero-detail],
  [data-hero-eyebrow],
  [data-hero-status],
  [data-hero-badge] {
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }
  .hero-copy-changing {
    opacity: 0;
    transform: translateY(5px);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    [data-hero-phrase],
    [data-hero-detail],
    [data-hero-eyebrow],
    [data-hero-status],
    [data-hero-badge] {
      transition: none;
    }
  }
</style>

<script define:vars={{ slides }}>
  const images = document.querySelectorAll("[data-hero-slide]");
  const phrase = document.querySelector("[data-hero-phrase]");
  const detail = document.querySelector("[data-hero-detail]");
  const eyebrow = document.querySelector("[data-hero-eyebrow]");
  const status = document.querySelector("[data-hero-status]");
  const badge = document.querySelector("[data-hero-badge]");
  const hero = document.querySelector("[data-hero-slide]")?.closest("section");
  let current = 0;
  let timer;

  const setSlide = (next) => {
    current = (next + slides.length) % slides.length;
    [phrase, detail, eyebrow, status, badge].forEach((element) =>
      element?.classList.add("hero-copy-changing"),
    );
    window.setTimeout(() => {
      const slide = slides[current];
      images.forEach((image, index) =>
        image.classList.toggle("is-active", index === current),
      );
      if (phrase) phrase.textContent = slide.phrase;
      if (detail) detail.textContent = slide.detail;
      if (eyebrow) eyebrow.lastChild.textContent = ` ${slide.eyebrow}`;
      if (status)
        status.lastElementChild.textContent = `La pinta exacta · ${String(current + 1).padStart(2, "0")} / 03`;
      if (badge) badge.innerHTML = slide.phrase.replace(".", "<br />");
      [phrase, detail, eyebrow, status, badge].forEach((element) =>
        element?.classList.remove("hero-copy-changing"),
      );
    }, 250);
  };
  const restart = () => {
    window.clearInterval(timer);
    timer = window.setInterval(() => setSlide(current + 1), 5200);
  };
  document.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
    setSlide(current - 1);
    restart();
  });
  document.querySelector("[data-hero-next]")?.addEventListener("click", () => {
    setSlide(current + 1);
    restart();
  });
  hero?.addEventListener("mouseenter", () => window.clearInterval(timer));
  hero?.addEventListener("mouseleave", restart);
  restart();
</script>
