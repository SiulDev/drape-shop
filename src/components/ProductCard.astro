---
interface Props {
  nombre: string;
  tallas: string;
  precioUSD: number;
  imagen: string;
  enStock: boolean;
}

const { nombre, tallas, precioUSD, imagen, enStock } = Astro.props;
const numeroWhatsApp = "584123401963";
const mensaje = encodeURIComponent(
  `Hola Drape, me interesa el artículo: *${nombre}*.\n\n¿Aún tienen disponibilidad en tallas ${tallas}?\n\nReferencia del producto: ${imagen}`,
);
const waLink = `https://wa.me/${numeroWhatsApp}?text=${mensaje}`;
---

<article
  class="group flex w-full h-full flex-col border-2 rounded-2xl border-black bg-card p-3 shadow-lg shadow-black/15 transition-transform hover:-translate-y-1 sm:p-4"
>
  <div
    class="relative aspect-4/5 overflow-hidden border-2 rounded-2xl border-black bg-card"
  >
    <img
      src={imagen}
      alt={nombre}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />

    <span
      class:list={[
        "absolute left-2 top-2 border-2  border-black px-2 py-1 font-mono text-[10px] font-bold uppercase",
        enStock ? "bg-lime text-black" : "bg-red-drape text-cream",
      ]}
    >
      {enStock ? "En stock" : "Agotado"}
    </span>

    {!enStock && <span class="absolute inset-0 bg-black/40" />}
  </div>

  <div class="flex flex-1 flex-col gap-3 pt-4">
    <h3 class="text-sm font-bold leading-snug text-ink sm:text-base">
      {nombre}
    </h3>

    <div class="font-mono">
      <p class="text-xl font-bold leading-none text-ink">${precioUSD}</p>
      <span
        class="precio-bs-dinamico mt-2 block text-xs font-bold text-ink"
        data-usd={precioUSD}></span>
    </div>

    <p class="font-mono text-xs font-medium text-ink-soft">Tallas: {tallas}</p>

    {
      enStock ? (
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto flex items-center justify-center gap-2 border-2 border-black rounded-3xl bg-ink px-3 py-3 text-center text-xs font-bold text-cream transition-colors hover:bg-red-drape"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2" />
          </svg>
          Pedir por WhatsApp
        </a>
      ) : (
        <button
          disabled
          class="mt-auto w-full cursor-not-allowed border-4 border-black bg-ink/20 px-3 py-2 text-center text-xs font-bold text-ink-soft"
        >
          Sin stock
        </button>
      )
    }
  </div>
</article>
