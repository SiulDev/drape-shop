---
interface Props {
  slug: string;
  name: string;
  brand: string;
  sizes: string;
  price: number;
  inStock: boolean;
  img: string;
  imgBack?: string;
}

const product = Astro.props;
const { slug, name, brand, sizes, price, inStock, img, imgBack = "" } = product;
const imagenAtras = imgBack || "";
const nombre = name;
const tallas = sizes;
const precioUSD = price;
const imagen = img;
const numeroWhatsApp = "584123401963";
const mensajeBase = `Hola DRAPE, me interesa comprar la pieza: ${nombre}\nPrecio: $${precioUSD}\nTalla: ${tallas}\nReferencia visual: ${imagen}`;
const hrefWhatsapp = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensajeBase)}`;
const tallasArray = tallas
  .split(/[\s,]+/)
  .map((talla) => talla.trim())
  .filter(Boolean);
---

<article
  class="group flex h-full w-full select-none flex-col overflow-hidden rounded-2xl border-2 border-black bg-[#f4efe4] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform duration-200 hover:-translate-y-0.5"
>
  <div
    class="relative mb-2 aspect-[4/5] overflow-hidden border-b-2 border-black bg-[#e8e1d3] md:mb-4"
  >
    <img
      src={imagen}
      alt={nombre}
      data-product-image
      data-imagen-frente={imagen}
      data-imagen-atras={imagenAtras}
      loading="lazy"
      decoding="async"
      class="h-full w-full cursor-pointer object-cover transition-transform duration-500 hover:scale-[1.03]"
    />

    {!product.inStock && <span class="absolute inset-0 bg-black/25" />}
  </div>

  <div class="flex h-full flex-col gap-4 p-2 md:p-5">
    <h3
      class="text-sm md:text-lg font-bold leading-tight line-clamp-2 min-h-[2.5rem] md:min-h-[3rem] uppercase text-black"
    >
      {name}
    </h3>

    <div class="mt-1 flex items-start justify-between gap-3">
      <div class="flex flex-col bg-transparent font-mono">
        <p class="text-base md:text-2xl font-mono font-extrabold text-black">
          ${precioUSD}
        </p>
      </div>

      <div
        class="mt-1 rounded-sm border-2 border-black bg-transparent px-1 py-1 text-[8px] font-bold uppercase text-black md:px-2 md:text-[10px]"
      >
        {product.inStock ? "EN STOCK" : "AGOTADO"}
      </div>
    </div>

    <div class="mt-auto flex flex-col gap-3 pt-4">
      <div class="flex flex-col gap-2">
        <p
          class="font-mono text-[9px] md:text-xs mr-1 font-bold uppercase tracking-[0.18em] text-black/70"
        >
          TALLAS
        </p>

        <div class="flex flex-wrap gap-1 items-center">
          {
            tallasArray.length > 0 ? (
              tallasArray.map((talla) => (
                <span class="border border-black px-1.5 py-0.5 text-[9px] md:text-xs font-bold uppercase rounded-full bg-transparent text-black whitespace-nowrap">
                  {talla}
                </span>
              ))
            ) : (
              <span class="font-mono text-xs text-black/60">Sin tallas</span>
            )
          }
        </div>
      </div>

      {
        product.inStock ? (
          <a
            href={hrefWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-black text-white font-bold py-2 md:py-3 px-1 rounded-lg hover:bg-gray-800 transition-colors flex justify-center items-center gap-1 md:gap-2 mt-2"
          >
            <span class="text-[10px] md:text-sm whitespace-nowrap">
              Pedir por WhatsApp
            </span>
          </a>
        ) : (
          <button
            disabled
            class="w-full cursor-not-allowed rounded-lg border-2 border-black bg-transparent px-3 py-3 text-center text-sm font-bold text-black/50"
          >
            Sin stock
          </button>
        )
      }
    </div>
  </div>
</article>

<dialog
  class="product-modal select-none m-0 h-full max-h-none w-full max-w-none bg-transparent p-3 backdrop:bg-black/75 sm:p-5 md:p-8"
  data-product-modal
>
  <div class="flex h-full w-full select-none items-center justify-center">
    <div
      class="relative w-full max-w-5xl overflow-hidden rounded-[30px] border border-black/80 bg-[#f5f0e2] shadow-[0_30px_90px_rgba(20,19,13,0.18)]"
    >
      <button
        type="button"
        class="absolute right-4 top-4 z-20 rounded-full border border-black bg-cream px-3 py-2 text-xl font-bold leading-none text-black transition-colors hover:bg-red-drape hover:text-cream"
        data-close-modal
        aria-label="Cerrar detalle del producto"
      >
        ×
      </button>

      <div class="grid gap-0 md:grid-cols-2">
        <div
          class="flex flex-col border-b border-black/70 bg-[#f3efe5] md:border-b-0 md:border-r"
        >
          <div
            class="aspect-square w-full overflow-hidden bg-[#f7f4ed] p-4 sm:p-5 md:p-6"
          >
            <img
              src={imagen}
              alt={nombre}
              data-modal-image
              data-modal-frente={imagen}
              data-modal-atras={imagenAtras}
              data-current="frente"
              class="h-full w-full cursor-pointer object-cover object-center transition-opacity duration-300"
            />
          </div>

          {
            imagenAtras ? (
              <div class="flex items-center justify-center gap-2 border-t border-black/70 bg-[#f9f5ee] p-3">
                <button
                  type="button"
                  data-view-toggle="frente"
                  class="rounded-full border border-black bg-ink px-3 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-cream"
                >
                  Vista Frontal
                </button>
                <button
                  type="button"
                  data-view-toggle="atras"
                  class="rounded-full border border-black bg-white px-3 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-black"
                >
                  Vista Trasera
                </button>
              </div>
            ) : null
          }
        </div>

        <div
          class="flex flex-col justify-center bg-transparent p-5 text-left sm:p-6 md:p-7"
        >
          <h2 class="text-2xl font-black leading-tight text-black sm:text-3xl">
            {nombre}
          </h2>

          <div class="mt-4 flex items-end justify-between gap-3">
            <div class="flex flex-col bg-transparent font-mono">
              <p class="text-4xl font-extrabold tracking-tight text-black">
                ${precioUSD}
              </p>
            </div>

            <span
              class="rounded-full border border-black bg-transparent px-2 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-black"
            >
              {product.inStock ? "EN STOCK" : "AGOTADO"}
            </span>
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            {
              tallasArray.map((talla) => (
                <span class="inline-flex min-w-[2.8rem] items-center justify-center rounded-full border border-black bg-transparent px-3 py-1 text-sm font-bold uppercase text-black">
                  {talla}
                </span>
              ))
            }
          </div>

          <div
            class="flex items-center justify-between w-full border-2 border-black rounded-full px-1.5 py-0.5 md:px-3 md:py-1.5 text-[9px] md:text-xs mt-2 overflow-hidden"
          >
            <span
              class="text-[8px] md:text-xs font-bold whitespace-nowrap uppercase tracking-[0.2em] text-black"
            >
              <span class="hidden md:inline mr-1">ESTADO</span>
            </span>
            <div class="flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500"
              ></span>
              <span
                class="text-[8px] md:text-xs font-bold whitespace-nowrap uppercase tracking-[0.18em] text-black"
              >
                {product.inStock ? "DISPONIBLE" : "AGOTADO"}
              </span>
            </div>
          </div>

          {
            product.inStock ? (
              <a
                href={hrefWhatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-black text-white font-bold py-2 md:py-3 px-1 rounded-lg hover:bg-gray-800 transition-colors flex justify-center items-center gap-1 md:gap-2 mt-2"
              >
                <span class="inline-flex items-center justify-center gap-1 md:gap-2 text-[10px] md:text-sm whitespace-nowrap">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2" />
                  </svg>
                  Pedir producto
                </span>
              </a>
            ) : (
              <button
                disabled
                class="mt-5 w-full cursor-not-allowed rounded-full border-2 border-black bg-transparent px-5 py-4 text-base font-bold text-black/60"
              >
                Producto agotado
              </button>
            )
          }
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  // @ts-nocheck
  document.querySelectorAll("[data-product-image]").forEach((image) => {
    const article = image.closest("article");
    const modal = article?.nextElementSibling;
    const modalImage = modal?.querySelector("[data-modal-image]");
    const closeButton = modal?.querySelector("[data-close-modal]");
    const viewButtons = modal?.querySelectorAll("[data-view-toggle]");

    if (!modal || !modalImage) return;

    const setView = (view) => {
      const frente = modalImage.dataset.modalFrente;
      const atras = modalImage.dataset.modalAtras;
      const selectedView = view === "atras" && atras ? "atras" : "frente";

      modalImage.dataset.current = selectedView;
      modalImage.src = selectedView === "atras" ? atras : frente;

      viewButtons?.forEach((button) => {
        const isActive = button.dataset.viewToggle === selectedView;
        button.classList.toggle("bg-ink", isActive);
        button.classList.toggle("text-cream", isActive);
        button.classList.toggle("bg-white", !isActive);
        button.classList.toggle("text-black", !isActive);
      });
    };

    image.addEventListener("click", () => {
      modalImage.src = image.dataset.imagenFrente || image.src;
      modalImage.dataset.current = "frente";
      setView("frente");
      modal.showModal();
    });

    closeButton?.addEventListener("click", () => modal.close());

    viewButtons?.forEach((button) => {
      button.addEventListener("click", () =>
        setView(button.dataset.viewToggle),
      );
    });

    modalImage.addEventListener("click", () => {
      if (!modalImage.dataset.modalAtras) return;
      const nextView =
        modalImage.dataset.current === "atras" ? "frente" : "atras";
      setView(nextView);
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  });
</script>
